{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_PAT_TOKEN}"
      }
    },
    "vercel": {
      "url": "https://mcp.vercel.com"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/brown/workspace"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "supabase": {
      "type": "stdio",
      "command": "/Users/brown/workspace/every-shift-mvp/scripts/mcp/supabase.sh",
      "args": []
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx -y @modelcontextprotocol/server-sequential-thinking"
    },
    "git": {
      "type": "stdio",
      "command": "/Users/brown/.local/bin/uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "/Users/brown/workspace/every-shift-mvp"
      ]
    }
  }
}
