# EveryShift MVP - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# AI Solver API Base URL
# Development: keep empty to use Vite proxy (/api -> Cloud Run target)
VITE_API_BASE_URL=
# Production: set absolute URL in deployment environment
# Example: VITE_API_BASE_URL=https://every-shift-api-service-554455861916.asia-northeast3.run.app

# Public Hospital API (data.go.kr)
# If empty, signup hospital search falls back to Supabase organizations/default list.
VITE_HOSPITAL_API_BASE_URL=https://apis.data.go.kr/B551182/hospInfoServicev2/getHospBasisList
VITE_HOSPITAL_API_KEY=

# Application Configuration
VITE_APP_NAME=EveryShift
VITE_APP_VERSION=1.0.0-mvp

# Feature Flags (Optional)
VITE_ENABLE_MOCK_SOLVER=true
VITE_ENABLE_DEBUG=false

# Signup behavior
# - default(dev): mock signup response, skip remote Edge Function invoke
# - set true to force remote invoke in dev for integration debugging
VITE_SIGNUP_FORCE_REMOTE=false
