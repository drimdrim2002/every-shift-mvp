# EveryShift MVP - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# AI Solver API Base URL (optional)
# Leave empty for the Vercel same-origin /api function proxy.
# Set only when intentionally calling the Cloud Run REST API directly.
VITE_API_BASE_URL=

# Application Configuration
VITE_APP_NAME=EveryShift
VITE_APP_VERSION=1.0.0-mvp
VITE_PUBLIC_INQUIRY_FORM_URL=https://forms.gle/YOUR_PUBLIC_INQUIRY_FORM_ID

# Feature Flags (Optional)
VITE_ENABLE_MOCK_SOLVER=true
VITE_ENABLE_DEBUG=false
