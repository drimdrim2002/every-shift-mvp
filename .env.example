# EveryShift MVP - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# AI Solver API Base URL (optional)
# Leave empty for the Vercel same-origin /api function proxy.
# pnpm dev does not proxy to Cloud Run unless this is explicitly set.
# Set only for temporary direct calls while Cloud Run still allows public access.
VITE_API_BASE_URL=

# Solver proxy server-only configuration
# Set these in Vercel environment variables, not as VITE_* browser variables.
# Enable Secure Backend Access with OIDC Federation in Vercel Security settings.
CLOUD_RUN_API_ORIGIN=https://every-shift-api-service-554455861916.asia-northeast3.run.app
# Optional override; leave empty to use CLOUD_RUN_API_ORIGIN as the ID token audience.
CLOUD_RUN_TARGET_AUDIENCE=
GCP_PROJECT_NUMBER=554455861916
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-solver
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel-prod
GCP_SERVICE_ACCOUNT_EMAIL=vercel-solver-proxy-invoker@every-shift-api.iam.gserviceaccount.com

# Application Configuration
VITE_APP_NAME=EveryShift
VITE_APP_VERSION=1.0.0-mvp
VITE_PUBLIC_INQUIRY_FORM_URL=https://forms.gle/YOUR_PUBLIC_INQUIRY_FORM_ID

# Feature Flags (Optional)
VITE_ENABLE_MOCK_SOLVER=true
VITE_ENABLE_DEBUG=false
