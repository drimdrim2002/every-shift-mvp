# EveryShift MVP - Frontend Environment Variables
# Copy this file to .env.local and fill in actual values.

# Required: Supabase client configuration
# Get values from Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: Solver API base URL
# - Development: keep empty to use Vite proxy (/api)
# - Production: set absolute API URL in deployment env
VITE_API_BASE_URL=

# Optional: Signup behavior flags
# - VITE_ENABLE_MOCK_SIGNUP=true enables local mock signup responses
# - VITE_SIGNUP_FORCE_REMOTE=true forces Edge Function invoke even in dev
VITE_ENABLE_MOCK_SIGNUP=false
VITE_SIGNUP_FORCE_REMOTE=false
