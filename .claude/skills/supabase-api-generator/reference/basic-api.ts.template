import { supabase } from '@/api/supabase';

interface ScheduleRow {
  id: string;
  organization_id: string;
  month: string;
  status: 'created' | 'running' | 'complete' | 'changed' | 'error';
  created_at: string;
  updated_at: string;
}

interface ScheduleModel {
  id: string;
  organizationId: string;
  month: string;
  status: 'created' | 'running' | 'complete' | 'changed' | 'error';
  createdAt: string;
  updatedAt: string;
}

function toScheduleModel(row: ScheduleRow): ScheduleModel {
  return {
    id: row.id,
    organizationId: row.organization_id,
    month: row.month,
    status: row.status,
    createdAt: row.created_at,
    updatedAt: row.updated_at,
  };
}

export async function getScheduleById(scheduleId: string): Promise<ScheduleModel> {
  const { data, error } = await supabase.from('schedules').select('*').eq('id', scheduleId).single();

  if (error) {
    console.error('[scheduleApi:getScheduleById] query failed', error);
    throw new Error(`근무표 조회 실패: ${error.message}`);
  }

  return toScheduleModel(data as ScheduleRow);
}

export async function findScheduleByMonth(
  organizationId: string,
  month: string
): Promise<ScheduleModel | null> {
  const { data, error } = await supabase
    .from('schedules')
    .select('*')
    .eq('organization_id', organizationId)
    .eq('month', month)
    .maybeSingle();

  if (error) {
    console.error('[scheduleApi:findScheduleByMonth] query failed', error);
    throw new Error(`근무표 조회 실패: ${error.message}`);
  }

  return data ? toScheduleModel(data as ScheduleRow) : null;
}
