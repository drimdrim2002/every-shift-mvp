{
  "mcpServers": {
    "supabase": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/mcp/supabase.sh"]
    },
    "shrimp-task-manager": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/mcp/shrimp-task-manager.sh"]
    },
    "context7": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/mcp/context7.sh"]
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/mcp/sequential-thinking.sh"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {
        "PLAYWRIGHT_BROWSER": "chromium",
        "PLAYWRIGHT_HEADLESS": "true"
      }
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server"],
      "env": {
        "SERENA_AUTO_OPEN_BROWSER": "false"
      }
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/brown/projects"]
    },
    "git": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "/home/brown/projects/every-shift-mvp"]
    }
  }
}
